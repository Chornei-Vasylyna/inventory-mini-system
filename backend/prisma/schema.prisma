generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  out_of_stock
  low_stock
  in_stock
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  quantity    Int
  price       Decimal
  status      ProductStatus
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime?     @updatedAt @map("updated_at")

  @@map("products")
}
